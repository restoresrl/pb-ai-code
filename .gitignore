# Layer 1 — Appeon docs index (HTML cache + SQLite FTS5 DB)
# Mirror artefacts are user-side, not committed. Only the source
# code (scraper + parser + indexer + MCP server) and the seed
# config live in the repo.
.appeon-cache/
docs/appeon-index/*.db
docs/appeon-index/*.sqlite
docs/appeon-index/*.sqlite3
docs/appeon-index/*.sqlite-journal

# Layer 3 — per-workspace private knowledge (reserved for future codebase-aware
# layer; lives in the developer's PB workspace, never in this repo).
.knowledge/

# pb-source-analyzer intermediate workdir. scan.json contains real file
# paths from the corpus (pre-anonymization); MUST stay out of the repo.
# Only the anonymized output rendered into docs/pb-source-format/ is public.
.pb-analyzer-tmp/

