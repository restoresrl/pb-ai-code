# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# `uv run`/`uv sync` write this. Not committed: what this repository asks a team
# to agree on is the toolchain version — the git tag, and the pins in
# harness/mcp-servers.json — not the resolution of the dev dependencies for the
# two optional local tools. Commit it if that ever stops being true.
uv.lock

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Harness-specific installs. The canonical skills / commands / settings / MCP
# config live in skills/, commands/, harness/<harness>/ and
# harness/mcp-servers.json; scripts/install-skills.ps1 materializes them into
# the places the assistant actually reads. Those copies are build artefacts —
# regenerate them, never edit them in place.
#
# .mcp.json is in here for the same reason as .claude/, and it is the rule this
# repository asks of its consumers: a project commits nothing agentic, because
# a committed copy of the server pin drifts from the canonical one the moment
# the tag moves. Run the installer to get it.
.claude/
.agents/
.cursor/
.codex/
.mcp.json
.github/copilot-instructions.md

# Layer 1 — Appeon docs index (HTML cache + SQLite FTS5 DB)
# Mirror artefacts are user-side, not committed. Only the source
# code (scraper + parser + indexer + MCP server) and the seed
# config live in the repo.
.appeon-cache/
docs/appeon-index/*.db
docs/appeon-index/*.sqlite
docs/appeon-index/*.sqlite3
docs/appeon-index/*.sqlite-journal

# Layer 3 — per-workspace private knowledge (reserved for future codebase-aware
# layer; lives in the developer's PB workspace, never in this repo).
.knowledge/

# pb-source-analyzer intermediate workdir. scan.json contains real file
# paths from the corpus (pre-anonymization); MUST stay out of the repo.
# Only the anonymized output rendered into docs/pb-source-format/ is public.
.pb-analyzer-tmp/

